/**
 * app.wxss — 全局样式
 * 幼儿园风格：暖色调、大圆角、卡通感
 */

/* ============== 设计变量 ============== */
page {
  --color-primary: #FF8A4C;        /* 主橙色 */
  --color-primary-light: #FFB98A;
  --color-secondary: #FFD56B;      /* 暖黄色 */
  --color-accent: #6BCB77;          /* 苹果绿 */
  --color-pink: #FF8FB3;
  --color-blue: #74C0FC;
  --color-text: #4A3B2A;            /* 深棕色，比纯黑温和 */
  --color-text-mute: #9C8B6F;
  --color-bg: #FFF8E7;              /* 米色背景 */
  --color-card: #FFFFFF;
  --color-shadow: rgba(255, 138, 76, 0.15);

  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ============== 通用容器 ============== */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx var(--color-shadow);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 16rpx 0;
}

.subtitle {
  font-size: 26rpx;
  color: var(--color-text-mute);
  margin-bottom: 24rpx;
}

/* ============== 按钮 ============== */
.btn {
  display: inline-block;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  text-align: center;
  border: none;
  box-shadow: 0 6rpx 0 #E66B2E;
}

.btn::after { border: none; }

.btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #E66B2E;
}

.btn-secondary {
  background: var(--color-secondary);
  color: var(--color-text);
  box-shadow: 0 6rpx 0 #E0B850;
}
.btn-secondary:active {
  box-shadow: 0 2rpx 0 #E0B850;
}

.btn-success {
  background: var(--color-accent);
  box-shadow: 0 6rpx 0 #4FA95D;
}
.btn-success:active {
  box-shadow: 0 2rpx 0 #4FA95D;
}

/* ============== 文字辅助 ============== */
.text-center { text-align: center; }
.text-mute { color: var(--color-text-mute); }
.text-primary { color: var(--color-primary); }
.text-success { color: var(--color-accent); }

.divider {
  height: 1rpx;
  background: #EEE4D0;
  margin: 24rpx 0;
}