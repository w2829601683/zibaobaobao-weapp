/* ============== 顶部成就 ============== */
.stats-hero {
  background: linear-gradient(135deg, #FFD56B 0%, #FF8A4C 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 138, 76, 0.3);
}

.stats-hero__row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 28rpx;
}

.big-stat {
  flex: 1;
  text-align: center;
}

.big-stat__num {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 8rpx;
}

.big-stat__num--stars { color: #FFF6D6; }

.big-stat__label {
  font-size: 24rpx;
  opacity: 0.95;
}

.big-progress {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.big-progress__fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.big-progress__text {
  font-size: 24rpx;
  text-align: center;
  opacity: 0.95;
}

/* ============== 测验统计卡 ============== */
.stats-card {
  margin-bottom: 32rpx;
}

.stats-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B2A;
  margin-bottom: 24rpx;
}

.stat-grid {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  background: #FFF8E7;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-item__num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF8A4C;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-item__label {
  font-size: 22rpx;
  color: #9C8B6F;
}

.stats-card__hint {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #FFF6D6;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #9C8B6F;
  text-align: center;
}

/* ============== 章节标题 ============== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B2A;
  margin: 32rpx 8rpx 20rpx;
}

/* ============== 分类列表 ============== */
.cat-list { margin-bottom: 16rpx; }

.cat-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.cat-item:active { transform: scale(0.98); }

.cat-item__icon {
  font-size: 48rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.cat-item__main { flex: 1; }

.cat-item__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3B2A;
  margin-bottom: 8rpx;
}

.cat-item__progress-bar {
  height: 10rpx;
  background: #F0E5C9;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.cat-item__progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.cat-item__sub {
  font-size: 22rpx;
  color: #9C8B6F;
}

/* ============== 已学字网格 ============== */
.learned-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.learned-item {
  background: linear-gradient(135deg, #FFF6D6 0%, #FFE9A8 100%);
  border-radius: 24rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 76, 0.12);
}

.learned-item:active { transform: scale(0.96); }

.learned-item__emoji {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.learned-item__char {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3B2A;
  margin-bottom: 4rpx;
}

.learned-item__pinyin {
  font-size: 20rpx;
  color: #FF8A4C;
  margin-bottom: 4rpx;
}

.learned-item__stars {
  font-size: 18rpx;
}

/* ============== 空状态 ============== */
.empty {
  text-align: center;
  padding: 80rpx 32rpx;
}

.empty__emoji {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.empty__text {
  font-size: 32rpx;
  color: #4A3B2A;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty__hint {
  font-size: 26rpx;
  color: #9C8B6F;
}

/* ============== 重置 ============== */
.reset-row {
  margin-top: 48rpx;
  text-align: center;
}

.reset-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #9C8B6F;
  background: #FFF8E7;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
}

.reset-btn:active { background: #FFE5E5; color: #FF8A8A; }