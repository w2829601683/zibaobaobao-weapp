/* ============== 答题页头 ============== */
.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.quiz-header__progress {
  font-size: 28rpx;
  color: #4A3B2A;
  font-weight: 600;
}

.quiz-header__score {
  font-size: 30rpx;
  color: #FF8A4C;
  font-weight: 700;
  background: #FFF6D6;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.quiz-progress-bar {
  height: 12rpx;
  background: #FFE9A8;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.quiz-progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #6BCB77 0%, #FFD56B 100%);
  border-radius: 999rpx;
  transition: width 0.3s;
}

/* ============== 题卡 ============== */
.quiz-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8E7 100%);
  border-radius: 40rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 76, 0.18);
}

.quiz-card__emoji {
  font-size: 240rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  animation: bounce 0.6s ease-out;
}

@keyframes bounce {
  0%   { transform: scale(0.5); opacity: 0; }
  60%  { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); }
}

.quiz-card__hint {
  font-size: 30rpx;
  color: #9C8B6F;
  font-weight: 600;
}

/* ============== 选项 ============== */
.options-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.option {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  border: 4rpx solid transparent;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s, background 0.2s, border-color 0.2s;
}

.option:active { transform: scale(0.97); }

.option.is-correct {
  background: #E8F8EB;
  border-color: #6BCB77;
  animation: pop 0.3s ease-out;
}

.option.is-wrong {
  background: #FFE5E5;
  border-color: #FF8A8A;
  animation: shake 0.4s;
}

@keyframes pop {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25%      { transform: translateX(-8rpx); }
  75%      { transform: translateX(8rpx); }
}

.option__char {
  font-size: 64rpx;
  font-weight: 700;
  color: #4A3B2A;
  margin-bottom: 8rpx;
}

.option__pinyin {
  font-size: 24rpx;
  color: #FF8A4C;
}

.option__check {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  font-size: 32rpx;
  color: #6BCB77;
  font-weight: 700;
}

.option__cross {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  font-size: 32rpx;
  color: #FF8A8A;
  font-weight: 700;
}

/* ============== 结算页 ============== */
.summary {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-top: 80rpx;
  box-shadow: 0 12rpx 36rpx rgba(255, 138, 76, 0.2);
}

.summary__emoji {
  font-size: 160rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  animation: bounce 0.8s ease-out;
}

.summary__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF8A4C;
  margin-bottom: 16rpx;
}

.summary__message {
  font-size: 28rpx;
  color: #9C8B6F;
  margin-bottom: 40rpx;
}

.summary__stats {
  background: #FFF8E7;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #F0E5C9;
  font-size: 28rpx;
}

.stat-row:last-child { border-bottom: none; }

.stat-row__label { color: #9C8B6F; }
.stat-row__value { color: #4A3B2A; font-weight: 700; }

.summary__actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}